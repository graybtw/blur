// Flatten dense setting groups into a few intentional panels while keeping
// every existing control and data attribute intact.
function buildSettingsCollections(){
    const makeCollection = (page, groups, label) => {
        if (!page || !groups.length) return;
        const collection = document.createElement("section");
        collection.className = "settings-collection";
        const heading = document.createElement("h3");
        heading.textContent = label;
        collection.appendChild(heading);
        groups.forEach((group, index) => {
            if (index > 0) {
                const divider = document.createElement("div");
                divider.className = "settings-subdivider";
                divider.setAttribute("aria-hidden", "true");
                collection.appendChild(divider);
            }
            group.querySelector("h3")?.remove();
            group.querySelector(".theme-section-caption")?.remove();
            while (group.firstChild) collection.appendChild(group.firstChild);
            group.remove();
        });
        page.appendChild(collection);
    };

    const appearance = settingsPanel.querySelector('[data-page="appearance"]');
    if (appearance) {
        const groups = [...appearance.querySelectorAll(":scope > .settings-group")];
        makeCollection(appearance, groups.slice(1, 3), "Interface");
        makeCollection(appearance, groups.slice(3), "Behavior");
    }

    const privacy = settingsPanel.querySelector('[data-page="settings-privacy"]');
    if (privacy) {
        const groups = [...privacy.querySelectorAll(":scope > .settings-group")];
        makeCollection(privacy, groups.slice(0, 2), "Privacy");
        makeCollection(privacy, groups.slice(2), "Anti-monitoring");
    }
}

buildSettingsCollections();

function bindAppearanceToggle(selector, key, className){
    const button = document.querySelector(selector);
    let enabled = false;
    try { enabled = localStorage.getItem(key) === "true"; } catch (e) {}
    const apply = on => {
        document.documentElement.classList.toggle(className, on);
        button?.classList.toggle("on", on);
        button?.setAttribute("aria-pressed", String(on));
    };
    apply(enabled);
    button?.addEventListener("click", () => {
        enabled = !enabled;
        try { localStorage.setItem(key, String(enabled)); } catch (e) {}
        apply(enabled);
    });
}

