  .chat-messages{padding:18px 8px 8px;}
  .message-row{padding-left:4px;padding-right:4px;}
  .chat-mentions-view{padding:24px 14px;}
}


/* =========================================================
   MENTION/PING INDICATORS
   Small danger-colored dot = "you were mentioned here and
   haven't opened it". Distinct from the accent unread dot.
   ========================================================= */

/* dot on the Chat item in the main Blur sidebar */
.nav-mention-dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--danger);
  margin-left:auto;
  flex-shrink:0;
}

.nav-mention-dot[hidden],
.channel-item.has-mention[hidden],
.dm-item.has-mention[hidden]{
  display:none;
}

/* keep the dot visible in the collapsed mobile rail, where the
   other nav spans are hidden */
@media (max-width:960px){
  .nav a span.nav-mention-dot,
  nav a span.nav-mention-dot{
    display:block;
    position:absolute;
    top:6px;
    right:6px;
    margin-left:0;
  }
}

/* dot on a channel in the channel list */
.channel-item.has-mention::after,
.dm-item.has-mention::after{
  content:'';
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--danger);
  margin-left:auto;
  flex-shrink:0;
}

.channel-item.has-mention{
  color:var(--text);
}

/* the mention dot supersedes the plain unread dot on DM items */
.dm-item.has-mention .dm-item-dot{
  display:none;
}

.forum-card-meta{font-size:9px;}

/* Final sidebar/message interaction pass. */
.chat-sidebar{width:224px;padding:12px 8px 10px;background:var(--sidebar);border-right:1px solid var(--border);}
.sidebar-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:0 2px 12px;padding:0;background:transparent;border:0;border-bottom:1px solid var(--border);border-radius:0;}
.sidebar-tab{position:relative;display:flex;align-items:center;justify-content:center;gap:5px;height:31px;padding:0 3px;border:0;border-radius:0;background:transparent;color:var(--muted-dim);font:10px var(--font-mono);letter-spacing:.01em;cursor:pointer;transition:color var(--speed) var(--curve),background var(--speed) var(--curve);}
.sidebar-tab:hover{background:var(--surface);color:var(--text);}
.sidebar-tab.active{background:transparent;box-shadow:none;color:var(--white);}
.sidebar-tab.active::after{content:"";position:absolute;left:10px;right:10px;bottom:-1px;height:2px;background:var(--accent);}
.sidebar-tab-icon{color:var(--muted-dim);font-size:12px;line-height:1;}
.sidebar-tab-icon svg{width:13px;height:13px;display:block;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;}
.sidebar-tab.active .sidebar-tab-icon{color:var(--accent);}
.friends-badge,.mentions-badge{margin-left:2px;min-width:14px;height:14px;padding:0 3px;font-size:8px;line-height:14px;}
.chat-sidebar-header{margin:12px 4px 5px;padding:0 6px;color:var(--muted-dim);font:9px var(--font-mono);letter-spacing:.16em;text-transform:uppercase;}
.channel-item,.dm-item{height:31px;min-height:31px;padding:0 8px;gap:8px;border-radius:6px;font-size:12px;}
.channel-item:hover,.dm-item:hover{background:var(--surface);}
.channel-item.active,.dm-item.active{background:#181818;box-shadow:inset 2px 0 var(--accent);}
.channel-hash{width:14px;color:var(--muted-dim);font:12px var(--font-mono);}
.channel-item.announcement{background:var(--surface);}
.channel-item.announcement:hover{background:var(--surface-2);}
.channel-item.announcement + .channel-item.announcement{border-top-left-radius:2px;border-top-right-radius:2px;}
.staff-channel-header{margin-top:10px;}
.chat-user-bar{padding-top:8px;}
.message-reply-btn,.message-react-btn{position:absolute;top:-6px;width:27px;height:27px;padding:0;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);color:var(--muted);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;cursor:pointer;transition:opacity var(--speed) var(--curve),background var(--speed) var(--curve),color var(--speed) var(--curve);}
.message-reply-btn{right:4px;}.message-react-btn{right:34px;}
.message-row:hover .message-reply-btn,.message-row:hover .message-react-btn,.message-row:focus-within .message-reply-btn,.message-row:focus-within .message-react-btn{opacity:1;pointer-events:auto;}
.message-reply-btn:hover,.message-react-btn:hover{background:var(--surface-2);color:var(--text);}
.message-reply-btn svg,.message-react-btn svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
.message-actions{top:-6px;right:64px;gap:2px;padding:2px;border-radius:var(--radius-sm);}
.message-actions button{width:27px;height:27px;padding:0;display:grid;place-items:center;}
.message-actions button[hidden]{display:none!important;}
.message-actions button svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
.message-reactions .reaction-add{display:none;}
 .forum-index{padding:22px clamp(18px,3vw,40px) 30px!important;}
 .forum-grid{gap:10px;}
 .forum-card{min-height:176px;border-radius:8px;}
@media(max-width:760px){.chat-sidebar{width:200px;padding-left:8px;padding-right:8px;}}
@media(max-width:560px){.chat-sidebar{width:100%;max-width:100%;}}

/* Discord-like reaction picker, kept in Blur's warm token palette. */
.reaction-popover{width:260px;max-width:calc(100vw - 16px);display:flex;flex-direction:column;gap:8px;padding:10px;border-radius:var(--radius-lg);background:var(--surface-overlay);border:1px solid var(--border-emphasis);box-shadow:var(--shadow-overlay);}
.reaction-popover-head{display:flex;align-items:center;justify-content:space-between;padding:0 2px 6px;border-bottom:1px solid var(--border);color:var(--text);font:600 11px var(--font-body);}
.reaction-view-all{height:24px;padding:0 7px;border:1px solid var(--border);border-radius:var(--radius-sm);background:transparent;color:var(--muted);font:10px var(--font-mono);cursor:pointer;}
.reaction-view-all:hover{background:var(--surface-2);color:var(--text);border-color:var(--border-strong);}
.reaction-quick-grid,.reaction-category>div{display:grid;grid-template-columns:repeat(6,1fr);gap:2px;}
.reaction-popover button[data-pick-emoji]{width:34px;height:32px;border:0;border-radius:var(--radius-sm);background:transparent;color:var(--text);font-size:18px;line-height:1;cursor:pointer;}
.reaction-popover button[data-pick-emoji]:hover{background:var(--surface-2);transform:translateY(-1px);}
.reaction-all-grid{display:flex;flex-direction:column;gap:9px;max-height:310px;overflow-y:auto;padding-right:2px;}
.reaction-category>span{display:block;margin:0 2px 4px;color:var(--muted-dim);font:9px var(--font-mono);letter-spacing:.08em;text-transform:uppercase;}
.reaction-category>div{grid-template-columns:repeat(8,1fr);}
.reaction-popover [hidden]{display:none!important;}
