  function positionModelDropdown(){ if (!modelDropdownEl || !els.modelSelector) return; const rect = els.modelSelector.getBoundingClientRect(); const width = Math.max(280, rect.width + 80); modelDropdownEl.style.width = `${Math.min(width, window.innerWidth - 16)}px`; modelDropdownEl.style.left = `${Math.max(8, Math.min(window.innerWidth - width - 8, rect.right - width))}px`; modelDropdownEl.style.bottom = `${Math.max(8, window.innerHeight - rect.top + 8)}px`; }
