    align-items:baseline;
    padding:13px 16px;
    border-bottom:1px solid var(--border);
    font-size:13px;
    line-height:1.45;
    color:var(--text);
    transition:background var(--speed) var(--curve);
}

.backstage-timeline-row:last-child{
    border-bottom:0;
}

.backstage-timeline-row:hover{
    background:var(--surface-2);
}

.backstage-timeline-num{
    flex:0 0 20px;
    font-family:var(--font-mono);
    font-size:10px;
    color:var(--accent);
    opacity:.8;
}

.backstage-grid{
    display:grid;
    grid-template-columns:1.08fr .92fr;
    gap:12px;
}

.backstage-card{
    min-width:0;
    padding:17px;
    border:1px solid var(--border);
    border-radius:var(--radius-md);
    background:var(--surface);
}

.backstage-items{
    display:flex;
    flex-direction:column;
    gap:13px;
}

.backstage-item{
    display:flex;
    flex-direction:column;
    gap:4px;
}

.backstage-item strong{
    font-size:12.5px;
    font-weight:600;
    color:var(--text);
}

.backstage-item span{
    font-size:11.5px;
    line-height:1.45;
    color:var(--muted);
}

.backstage-note-card{
    display:flex;
    flex-direction:column;
}

.backstage-note-card blockquote{
    margin:auto 0 13px;
    font-family:var(--font-display);
    font-size:22px;
    line-height:1.25;
    letter-spacing:-.01em;
    color:var(--white);
}

.backstage-note-caption{
    font-family:var(--font-mono);
    font-size:10px;
    color:var(--muted-dim);
    text-transform:uppercase;
    letter-spacing:.08em;
}

.backstage-empty{
    padding:15px 16px;
    color:var(--muted);
    font-size:12px;
}

.backstage-meta{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    padding-top:2px;
}

.backstage-meta div{
    display:flex;
    flex-direction:column;
    gap:5px;
    padding:11px 12px;
    border-left:2px solid var(--accent-dim);
    background:var(--surface-2);
}

.backstage-meta span{
    font-family:var(--font-mono);
    font-size:9px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--muted-dim);
}

.backstage-meta strong{
    font-size:11.5px;
    font-weight:500;
    color:var(--text);
}

.backstage-footer{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:14px 30px 18px;
    border-top:1px solid var(--border);
    color:var(--muted);
    font-size:11px;
}

.backstage-footer b{
    display:inline-block;
    width:6px;
    height:6px;
    margin-right:7px;
    border-radius:50%;
    background:var(--accent);
    vertical-align:1px;
}

.backstage-footer-hint{
    font-family:var(--font-mono);
    font-size:9px;
    letter-spacing:.06em;
    text-transform:uppercase;
    color:var(--muted-dim);
}

@media (max-width:600px){
    .backstage-modal{
        width:calc(100% - 20px);
        max-height:90vh;
    }

    .backstage-head,
    .backstage-body{
        padding-left:20px;
        padding-right:20px;
    }

    .backstage-footer{
        padding-left:20px;
        padding-right:20px;
    }

    .backstage-title-row{
        align-items:flex-start;
        gap:14px;
    }

    .backstage-index{
        flex-basis:56px;
        width:56px;
        height:56px;
    }

    .backstage-index strong{
        font-size:18px;
    }

    .backstage-grid,
    .backstage-meta,
    .backstage-board-grid{
        grid-template-columns:1fr;
    }

    .backstage-footer-hint{
        display:none;
    }
}

@media (prefers-reduced-motion:reduce){
    .backstage-timeline-row{
        transition:none;
    }
}

/* Long-idle pause screen */
.afk-overlay{
  position:fixed;
  inset:0;
  z-index:1000;
  display:grid;
  place-items:center;
  background:rgba(8,8,7,.72);
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  animation:afk-fade-in var(--speed-slow) var(--curve) both;
}

.afk-card{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
  text-align:center;
  padding:32px;
}

.afk-title{
  font-family:var(--font-display);
  font-size:clamp(64px,12vw,132px);
  font-weight:700;
  line-height:.9;
  letter-spacing:.02em;
  color:var(--text);
}

.afk-message{
  min-height:20px;
  color:var(--muted);
  font-size:14px;
  transition:opacity var(--speed-slow) var(--curve);
}

.afk-resume{
  margin-top:12px;
  min-width:112px;
  height:var(--control-h);
  padding:0 18px;
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  background:var(--surface);
  color:var(--text);
  font-size:13px;
  font-weight:600;
  cursor:pointer;
  transition:background var(--speed) var(--curve), border-color var(--speed) var(--curve), transform var(--speed) var(--curve);
}

.afk-resume:hover{
  border-color:var(--accent);
  background:var(--surface-2);
  transform:translateY(-1px);
}

@keyframes afk-fade-in{from{opacity:0}to{opacity:1}}

@media (prefers-reduced-motion:reduce){
  .afk-overlay{animation:none}
}

#settingsArchiveRow[hidden]{
    display:none;
}


/* ============ REDUCE MOTION (user setting) ============ */
/* Mirrors the prefers-reduced-motion handling; driven by the
   Appearance toggle (see settings.js). */

html.reduce-motion *,
html.reduce-motion *::before,
html.reduce-motion *::after{
    animation:none !important;
    transition:none !important;
    scroll-behavior:auto !important;
}

/* Optional appearance modes. */
html.focus-view .sidebar{
    opacity:1;
    background:var(--bg);
    border-right-color:transparent;
}
html.focus-view nav a:not(.active),
html.focus-view .bottom a:not(.active){ opacity:.52; }
html.focus-view nav a:not(.active):hover,
html.focus-view .bottom a:not(.active):hover{ opacity:1; }
