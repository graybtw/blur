/* ============================================================
   BlurGPT

   A focused conversation surface built from Blur's existing tokens.
   The layout intentionally stays quiet: one navigation rail, one
   reading column, one composer. No gradients, decorative chrome, or
   second design system.
============================================================ */

@keyframes aiEnter {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: none; }
}

@keyframes aiTyping {
  0%, 60%, 100% { opacity: .28; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-2px); }
}

@keyframes aiMenuIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Panel hand-off --------------------------------------------------------- */

main:has(.ai-panel.active) {
  align-items: stretch;
  justify-content: stretch;
  padding: 0;
  overflow: hidden;
  background: var(--bg);
}

.ai-panel.active {
  width: 100%;
  height: 100%;
}

.ai-app {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  color: var(--text-primary);
  background: var(--bg);
  font-family: var(--font-body);
}

/* Navigation rail ------------------------------------------------------- */

.ai-sidebar {
  position: relative;
  z-index: 4;
  display: flex;
  flex: 0 0 216px;
  flex-direction: column;
  width: 216px;
  min-width: 216px;
  min-height: 0;
  padding: 14px 9px 12px;
  border-right: 1px solid var(--border-subtle);
  background: var(--sidebar);
}

/* Blur's global shell already carries the brand. Keep this workspace
   focused on navigation instead of repeating the product lockup. */
.ai-sidebar-brand { display: none; }

.ai-mobile-close,
.ai-mobile-toggle { display: none; }

.ai-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 0 0 12px;
  border-bottom: 1px solid var(--border-subtle);
}

.ai-sidebar-nav-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 36px;
  gap: 10px;
  padding: 0 9px;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  text-align: left;
  font-size: var(--text-sm);
  transition: background var(--speed) var(--ease-standard),
              color var(--speed) var(--ease-standard);
}

.ai-sidebar-nav-item svg {
  width: 15px;
  height: 15px;
  flex: 0 0 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.55;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.ai-sidebar-nav-item:hover {
  color: var(--text-primary);
  background: var(--surface-raised);
}

.ai-sidebar-nav-item.active {
  color: var(--text-primary);
  background: var(--surface-selected);
  box-shadow: inset 2px 0 var(--accent);
}

.ai-sidebar-nav-count {
  margin-left: auto;
  color: var(--text-tertiary);
  font: 500 10px/1 var(--font-mono);
}

.ai-sidebar-section-label {
  display: flex;
  align-items: center;
  min-height: 31px;
  padding: 13px 8px 7px;
  color: var(--text-tertiary);
  font: 500 9px/1 var(--font-mono);
  letter-spacing: .12em;
}

.ai-sidebar-list {
  min-height: 0;
  flex: 1 1 auto;
  overflow: auto;
  padding: 0 1px;
}

.ai-sidebar-list::-webkit-scrollbar { width: 4px; }
.ai-sidebar-list::-webkit-scrollbar-thumb {
  border-radius: var(--radius-pill);
  background: var(--border-emphasis);
}

.ai-sidebar-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 36px;
  gap: 8px;
  padding: 5px 8px;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  text-align: left;
  cursor: pointer;
  transition: background var(--speed) var(--ease-standard),
              color var(--speed) var(--ease-standard);
}

.ai-sidebar-item:hover {
  color: var(--text-primary);
  background: var(--surface-raised);
}

.ai-sidebar-item.active {
  color: var(--text-primary);
  background: var(--surface-selected);
  box-shadow: inset 2px 0 var(--accent);
}

.ai-sidebar-item-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 0;
}

.ai-sidebar-item-copy strong {
  overflow: hidden;
  color: inherit;
  font-size: var(--text-sm);
  font-weight: 500;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-sidebar-item-copy small,
.ai-sidebar-empty small { display: none; }

.ai-sidebar-item-del {
  display: grid;
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  place-items: center;
  border-radius: var(--radius-sm);
  color: var(--text-tertiary);
  font-size: 15px;
  line-height: 1;
  opacity: 0;
  transition: opacity var(--speed) var(--ease-standard),
              background var(--speed) var(--ease-standard),
              color var(--speed) var(--ease-standard);
}

.ai-sidebar-item:hover .ai-sidebar-item-del,
.ai-sidebar-item:focus-within .ai-sidebar-item-del { opacity: 1; }
.ai-sidebar-item-del:hover {
  color: var(--text-primary);
  background: var(--surface-hover);
}

.ai-sidebar-empty {
  padding: 26px 8px;
  color: var(--text-tertiary);
  font-size: var(--text-sm);
  text-align: center;
}

.ai-sidebar-bottom {
  display: block;
  margin-top: auto;
  padding: 12px 2px 0;
  border-top: 1px solid var(--border-subtle);
}

.ai-usage-card {
  padding: 9px 9px 8px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.ai-usage-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.ai-usage-top span {
  color: var(--text-secondary);
  font-size: var(--text-xs);
}

.ai-usage-top strong {
  color: var(--text-primary);
  font: 500 10px/1 var(--font-mono);
}

.ai-usage-track {
  height: 3px;
  margin: 8px 0 7px;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: var(--surface-hover);
}

.ai-usage-track span {
  display: block;
  width: 0;
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
  transition: width var(--speed) var(--ease-standard);
}

.ai-usage-label {
  display: flex;
  justify-content: space-between;
  gap: 7px;
  color: var(--text-tertiary);
  font: 500 9px/1.2 var(--font-mono);
}

.ai-usage-label span:last-child {
  color: var(--text-secondary);
  white-space: nowrap;
}

/* Conversation ---------------------------------------------------------- */

.ai-main {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 0;
  flex: 1 1 auto;
  flex-direction: column;
  background: var(--bg);
}

.ai-chat-header {
  position: absolute;
  z-index: 3;
  inset: 0 0 auto;
  display: flex;
  align-items: center;
  min-height: 56px;
  gap: 11px;
  padding: 0 clamp(18px, 4vw, 48px);
  border-bottom: 1px solid var(--border-subtle);
  background: var(--bg);
}

.ai-header-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.ai-header-kicker {
  color: var(--text-tertiary);
  font: 500 9px/1 var(--font-mono);
  letter-spacing: .14em;
  text-transform: uppercase;
}

.ai-header-copy h1 {
  overflow: hidden;
  color: var(--text-primary);
  font: 500 17px/1.1 var(--font-display);
  letter-spacing: -.01em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-left: auto;
}

.ai-header-status {
  color: var(--text-tertiary);
  font: 500 9px/1 var(--font-mono);
  letter-spacing: .1em;
}

.ai-messages {
  position: relative;
  display: flex;
  min-height: 0;
  flex: 1 1 auto;
  flex-direction: column;
  gap: 24px;
  overflow: auto;
  padding: 84px clamp(20px, 8vw, 132px) 164px;
  scroll-behavior: smooth;
}

.ai-messages::-webkit-scrollbar { width: 6px; }
.ai-messages::-webkit-scrollbar-thumb {
  border-radius: var(--radius-pill);
  background: var(--border-emphasis);
}

.ai-empty {
  position: absolute;
  inset: 0;
  display: grid;
  width: auto;
  margin: 0;
  place-content: center;
  padding: 0 16px 90px;
  text-align: center;
  animation: aiEnter var(--speed-slow) var(--ease-standard);
}

.ai-empty-mark,
.ai-empty > p,
.ai-empty-note,
.ai-suggest-grid { display: none; }

.ai-empty h2 {
  color: var(--text-primary);
  font: 500 clamp(27px, 3vw, 36px)/1.08 var(--font-display);
  letter-spacing: -.025em;
}

.ai-msg {
  width: min(100%, 760px);
  margin: 0 auto;
  animation: aiEnter var(--speed) var(--ease-standard);
}

.ai-msg.user {
  align-self: center;
  padding: 0;
  border: 0;
  background: transparent;
}

.ai-msg.user .ai-msg-content {
  width: fit-content;
  max-width: min(75%, 600px);
  margin-left: auto;
  padding: 9px 12px;
  border: 1px solid var(--border-emphasis);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  background: var(--surface-2);
  font-size: 13px;
  line-height: 1.55;
}

.ai-msg.assistant { padding: 0; }

.ai-msg-head {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 7px;
}

.ai-msg-head span {
  color: var(--text-secondary);
  font: 500 10px/1 var(--font-body);
}

.ai-msg-head time {
  color: var(--text-tertiary);
  font: 500 10px/1 var(--font-mono);
}

.ai-provider-mark {
  display: grid;
  width: 19px;
  height: 19px;
  flex: 0 0 19px;
  place-items: center;
  overflow: hidden;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: var(--accent);
  background: var(--surface);
  font: 500 8px/1 var(--font-mono);
}

.ai-provider-mark img {
  width: 12px;
  height: 12px;
  object-fit: contain;
  filter: grayscale(1) sepia(.2);
  opacity: .86;
}

.ai-msg-content {
  overflow-wrap: anywhere;
  color: var(--text-primary);
  font-size: 14px;
  line-height: 1.68;
}

.ai-msg-content p { margin: 0 0 11px; }
.ai-msg-content p:last-child { margin-bottom: 0; }

.ai-msg-content h1,
.ai-msg-content h2,
.ai-msg-content h3 {
  margin: 17px 0 8px;
  color: var(--text-primary);
  font-family: var(--font-display);
  line-height: 1.15;
}

.ai-msg-content h1 { font-size: 24px; }
.ai-msg-content h2 { font-size: 20px; }
.ai-msg-content h3 { font-size: 17px; }
.ai-msg-content ul,
.ai-msg-content ol { margin: 7px 0 13px 21px; }
.ai-msg-content li { margin: 4px 0; padding-left: 2px; }
.ai-msg-content strong { font-weight: 700; }
.ai-msg-content em { color: var(--text-secondary); }
.ai-msg-content a {
  color: var(--accent);
  text-decoration: underline;
  text-decoration-color: var(--accent-dim);
  text-underline-offset: 2px;
}
.ai-msg-content a:hover { color: var(--text-primary); }
.ai-msg-content blockquote {
  margin: 9px 0;
  padding: 7px 12px;
  border-left: 2px solid var(--accent);
  color: var(--text-secondary);
  background: var(--surface-raised);
}
.ai-msg-content code {
  padding: 2px 5px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: var(--accent);
  background: var(--surface-raised);
  font: 500 .9em/1.2 var(--font-mono);
}
.ai-msg-content pre {
  max-width: 100%;
  margin: 11px 0;
  overflow: auto;
  padding: 12px 14px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  background: var(--surface-raised);
}
.ai-msg-content pre code {
  padding: 0;
  border: 0;
  color: var(--text-primary);
  background: transparent;
  white-space: pre;
}

.ai-typing-row { min-height: 32px; }
.ai-typing { display: inline-flex; gap: 5px; padding: 7px 0; }
.ai-typing span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--accent);
  animation: aiTyping 1.1s infinite var(--ease-standard);
}
.ai-typing span:nth-child(2) { animation-delay: .14s; }
.ai-typing span:nth-child(3) { animation-delay: .28s; }

.ai-error-message {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: min(100%, 760px);
  margin: 0 auto;
  gap: 12px;
  padding: 10px 13px;
  border: 1px solid var(--danger-border);
  border-radius: var(--radius-md);
  color: var(--danger);
  background: var(--danger-dim);
  font-size: var(--text-sm);
}

.ai-error-message button {
  flex: 0 0 auto;
  padding: 4px 8px;
  border: 1px solid var(--danger-border);
  border-radius: var(--radius-sm);
  color: var(--danger);
  font-size: var(--text-xs);
}

.ai-error-message button:hover { background: var(--surface-raised); }

/* Composer --------------------------------------------------------------- */

.ai-composer-wrap {
  position: absolute;
  z-index: 3;
  right: 0;
  bottom: 20px;
  left: 0;
  width: 100%;
  padding: 0 clamp(20px, 8vw, 132px);
}

.ai-main:has(.ai-empty) .ai-composer-wrap {
  top: 50%;
  bottom: auto;
  transform: translateY(32px);
}

.ai-composer-notice {
  width: min(100%, 760px);
  margin: 0 auto 8px;
  padding: 8px 11px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  background: var(--surface-raised);
  font-size: var(--text-sm);
}

.ai-composer-notice.warning {
  border-color: var(--accent-dim);
  color: var(--accent);
}

.ai-composer-notice.error {
  border-color: var(--danger-border);
  color: var(--danger);
}

.ai-composer {
  display: flex;
  width: min(100%, 760px);
  min-height: 98px;
  margin: 0 auto;
  flex-direction: column;
  padding: 12px 12px 8px 15px;
  border: 1px solid var(--border-emphasis);
  border-radius: var(--radius-lg);
  background: var(--surface);
  transition: border-color var(--speed) var(--ease-standard),
              background var(--speed) var(--ease-standard);
}

.ai-composer:focus-within {
  border-color: var(--accent);
  background: var(--surface-2);
  box-shadow: var(--focus-ring);
}

.ai-composer textarea {
  width: 100%;
  min-height: 39px;
  max-height: 180px;
  resize: none;
  border: 0;
  outline: 0;
  color: var(--text-primary);
  background: transparent;
  font: 400 var(--text-md)/1.55 var(--font-body);
}

.ai-composer textarea::placeholder { color: var(--text-tertiary); }

.ai-composer-bottom {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  margin-top: 8px;
}

.ai-composer-hint {
  min-width: 0;
  color: var(--text-tertiary);
  font: 500 10px/1 var(--font-mono);
}

.ai-composer-controls {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  align-items: center;
  justify-content: flex-start;
  gap: 2px;
}

.ai-composer-tool {
  display: inline-flex;
  align-items: center;
  min-height: 29px;
  gap: 6px;
  padding: 0 8px;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  font-size: var(--text-xs);
  transition: background var(--speed) var(--ease-standard),
              color var(--speed) var(--ease-standard);
}

.ai-composer-tool svg {
  width: 14px;
  height: 14px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.ai-composer-tool:hover {
  color: var(--text-primary);
  background: var(--surface-hover);
}

.ai-composer-tool.active {
  color: var(--accent);
  background: var(--accent-dim);
}

.ai-model-selector {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  max-width: 218px;
  height: 29px;
  gap: 7px;
  padding: 0 8px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  background: var(--surface-raised);
  font-size: var(--text-xs);
  transition: background var(--speed) var(--ease-standard),
              border-color var(--speed) var(--ease-standard),
              color var(--speed) var(--ease-standard);
}

.ai-model-selector:hover,
.ai-model-selector.active {
  color: var(--text-primary);
  border-color: var(--border-emphasis);
  background: var(--surface-hover);
}

.ai-model-selector:focus-visible {
  border-color: var(--accent);
  outline: none;
  box-shadow: var(--focus-ring);
}

.ai-model-icon {
  display: grid;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  place-items: center;
}

.ai-model-icon .ai-provider-mark {
  width: 17px;
  height: 17px;
  flex-basis: 17px;
  border: 0;
  background: transparent;
}

.ai-model-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-model-arrow {
  margin-left: 2px;
  color: var(--text-tertiary);
  font-size: 12px;
}

/* The selector menu is rendered at document level so it can escape the
   composer’s stacking context. Keep it visually anchored to the same Blur
   surface language as the rest of the AI controls. */
.ai-model-dropdown {
  position: fixed;
  z-index: 80;
  max-height: min(440px, calc(100vh - 24px));
  overflow: auto;
  padding: 8px;
  border: 1px solid var(--border-emphasis);
  border-radius: var(--radius-lg);
  background: var(--surface-raised);
  box-shadow: var(--shadow-overlay);
  animation: aiMenuIn 140ms var(--ease-standard) both;
}

.ai-model-dropdown-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 5px 6px 9px;
  border-bottom: 1px solid var(--border-subtle);
}

.ai-model-dropdown-head div {
  display: grid;
  gap: 4px;
}

.ai-model-dropdown-head span,
.ai-model-group-label {
  color: var(--text-tertiary);
  font: 500 9px/1 var(--font-mono);
  letter-spacing: .09em;
  text-transform: uppercase;
}

.ai-model-dropdown-head strong {
  color: var(--text-primary);
  font-size: var(--text-sm);
  font-weight: 600;
}

.ai-model-dropdown-head button {
  min-height: 25px;
  padding: 0 8px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  background: transparent;
  font-size: var(--text-xs);
}

.ai-model-dropdown-head button:hover {
  color: var(--text-primary);
  background: var(--surface-hover);
}

.ai-model-group-label {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 11px 7px 5px;
  letter-spacing: .07em;
}

.ai-model-group-logo {
  width: 16px;
  height: 16px;
  flex-basis: 16px;
  border: 0;
  background: transparent;
}

.ai-model-group-logo img { width: 12px; height: 12px; }

.ai-model-option {
  display: grid;
  width: 100%;
  min-height: 48px;
  grid-template-columns: 23px minmax(0, 1fr) auto 18px;
  align-items: center;
  gap: 8px;
  padding: 7px 8px;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  text-align: left;
  transition: background var(--speed) var(--ease-standard),
              color var(--speed) var(--ease-standard),
              border-color var(--speed) var(--ease-standard);
}

.ai-model-option:hover,
.ai-model-option.active {
  border-color: var(--border-subtle);
  color: var(--text-primary);
  background: var(--surface-hover);
}

.ai-model-option.active { box-shadow: inset 2px 0 var(--accent); }

.ai-model-option-logo {
  width: 22px;
  height: 22px;
  flex-basis: 22px;
}

.ai-model-option-copy {
  display: grid;
  min-width: 0;
  gap: 3px;
}

.ai-model-option-copy strong {
  overflow: hidden;
  color: inherit;
  font-size: var(--text-sm);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-model-option-copy small {
  overflow: hidden;
  color: var(--text-tertiary);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-model-option-meta {
  color: var(--text-tertiary);
  font: 500 9px/1 var(--font-mono);
  white-space: nowrap;
}

.ai-model-option-check {
  color: var(--accent);
  font: 600 13px/1 var(--font-mono);
  text-align: center;
}

.ai-send {
  width: 31px;
  height: 31px;
  flex: 0 0 31px;
  margin-left: auto;
  color: var(--bg);
  border-color: var(--accent);
  border-radius: var(--radius-md);
  background: var(--accent);
}

.ai-send:hover {
  color: var(--bg);
  border-color: var(--accent);
  background: var(--accent);
  opacity: .86;
}

.ai-send:disabled {
  color: var(--text-tertiary);
  border-color: var(--border-subtle);
  background: var(--surface-hover);
}

.ai-composer-footnote {
  width: min(100%, 760px);
  margin: 7px auto 0;
  color: var(--text-tertiary);
  font: 500 9px/1.2 var(--font-mono);
  text-align: center;
}

/* Cowork popover --------------------------------------------------------- */

.ai-cowork-popover {
  position: fixed;
  z-index: 40;
  width: min(396px, calc(100vw - 20px));
  padding: 14px;
  border: 1px solid var(--border-emphasis);
  border-radius: var(--radius-lg);
  background: var(--surface-overlay);
  box-shadow: var(--shadow-overlay);
  animation: aiEnter var(--speed) var(--ease-standard);
}

.ai-cowork-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.ai-cowork-head > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.ai-cowork-head span {
  color: var(--text-tertiary);
  font: 500 9px/1 var(--font-mono);
  letter-spacing: .13em;
}

.ai-cowork-head h2 {
  color: var(--text-primary);
  font: 500 20px/1.1 var(--font-display);
}

.ai-cowork-close {
  display: grid;
  width: 26px;
  height: 26px;
  place-items: center;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  color: var(--text-tertiary);
  font-size: 18px;
  line-height: 1;
}

.ai-cowork-close:hover {
  border-color: var(--border-subtle);
  color: var(--text-primary);
  background: var(--surface-hover);
}

.ai-cowork-check {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 11px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  background: var(--surface);
  cursor: pointer;
}

.ai-cowork-check:focus-within {
  border-color: var(--accent);
  box-shadow: var(--focus-ring);
}

.ai-cowork-check input {
  width: 14px;
  height: 14px;
  flex: 0 0 14px;
  margin-top: 2px;
  accent-color: var(--accent);
}

.ai-cowork-check span {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.ai-cowork-check strong {
  color: var(--text-primary);
  font-size: var(--text-sm);
  font-weight: 600;
}

.ai-cowork-check small {
  color: var(--text-tertiary);
  font-size: var(--text-xs);
  line-height: 1.35;
}

.ai-cowork-mode {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 35px;
  margin-top: 10px;
  padding: 0 10px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  background: var(--surface);
  font-size: var(--text-xs);
}

.ai-cowork-mode strong {
  color: var(--text-primary);
  font-weight: 500;
}

.ai-cowork-mode span {
  overflow: hidden;
  color: var(--text-tertiary);
  font: 500 9px/1 var(--font-mono);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-cowork-models,
.ai-cowork-note {
  color: var(--text-tertiary);
  font: 500 9px/1.45 var(--font-mono);
}

.ai-cowork-models {
  margin-top: 9px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-cowork-note { margin-top: 5px; }

/* Model catalog ---------------------------------------------------------- */

.ai-models-page[hidden] { display: none; }

.ai-models-page {
  position: absolute;
  inset: 0;
  display: flex;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  padding: 54px 32px 28px;
  background: var(--bg);
}

.ai-models-heading { margin-bottom: 16px; }
.ai-models-heading > span {
  display: block;
  margin-bottom: 8px;
}
.ai-models-heading h2 {
  color: var(--text-primary);
  font: 500 clamp(25px, 3vw, 32px)/1.1 var(--font-display);
}
.ai-models-heading p {
  margin-top: 7px;
  color: var(--text-secondary);
  font-size: var(--text-sm);
}

.ai-models-search {
  display: flex;
  align-items: center;
  min-height: 38px;
  gap: 9px;
  padding: 0 11px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.ai-models-search:focus-within {
  border-color: var(--accent);
  box-shadow: var(--focus-ring);
}

.ai-models-search > span {
  display: grid;
  width: 15px;
  height: 15px;
  flex: 0 0 15px;
  place-items: center;
  color: var(--text-tertiary);
}

.ai-models-search svg {
  width: 15px;
  height: 15px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
}

.ai-models-search input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  color: var(--text-primary);
  background: transparent;
  font: 500 var(--text-sm)/1 var(--font-body);
}

.ai-models-search input::placeholder { color: var(--text-tertiary); }

.ai-model-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 11px 0 16px;
}

.ai-model-filter {
  min-height: 28px;
  padding: 0 9px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  background: var(--surface);
  font-size: var(--text-xs);
}

.ai-model-filter:hover,
.ai-model-filter.active {
  color: var(--text-primary);
  background: var(--surface-selected);
}

.ai-model-filter.active { color: var(--accent); }

.ai-models-table {
  min-height: 0;
  overflow: auto;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.ai-models-table-head,
.ai-model-row {
  display: grid;
  grid-template-columns: minmax(220px, 1.8fr) minmax(90px, .7fr) minmax(100px, .8fr) minmax(100px, .8fr) 72px;
  align-items: center;
  column-gap: 12px;
}

.ai-models-table-head {
  min-height: 34px;
  padding: 0 14px;
  border-bottom: 1px solid var(--border-subtle);
  color: var(--text-tertiary);
  font: 500 9px/1 var(--font-mono);
  letter-spacing: .1em;
}

.ai-models-list { min-height: 0; }

.ai-model-row {
  width: 100%;
  min-height: 56px;
  padding: 0 14px;
  border-bottom: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  text-align: left;
  transition: background var(--speed) var(--ease-standard),
              color var(--speed) var(--ease-standard);
}

.ai-model-row:last-child { border-bottom: 0; }
.ai-model-row:hover,
.ai-model-row.active {
  color: var(--text-primary);
  background: var(--surface-selected);
}
.ai-model-row.active { box-shadow: inset 2px 0 var(--accent); }

.ai-model-row-logo {
  width: 27px;
  height: 27px;
  grid-column: 1;
  grid-row: 1;
}

.ai-model-row-name {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 3px;
  padding-left: 36px;
  grid-column: 1;
  grid-row: 1;
}

.ai-model-row-name strong {
  overflow: hidden;
  color: inherit;
  font-size: var(--text-sm);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-model-row-name small {
  color: var(--text-tertiary);
  font: 500 10px/1 var(--font-mono);
}

.ai-model-row-context,
.ai-model-row-capability,
.ai-model-row-price,
.ai-model-row-check {
  font: 500 10px/1 var(--font-mono);
}

.ai-model-row-context { grid-column: 2; }
.ai-model-row-capability { color: var(--text-tertiary); grid-column: 3; }
.ai-model-row-price { color: var(--text-tertiary); grid-column: 4; }
.ai-model-row-price i { color: var(--border-emphasis); font-style: normal; }
.ai-model-row-check { color: var(--accent); grid-column: 5; text-align: right; }
.ai-models-empty {
  padding: 32px 16px;
  color: var(--text-tertiary);
  font-size: var(--text-sm);
  text-align: center;
}

.ai-app.models-view .ai-messages,
.ai-app.models-view .ai-composer-wrap { display: none; }
.ai-app.models-view .ai-chat-header { display: none; }

/* Responsive / accessibility -------------------------------------------- */

@media (max-width: 780px) {
  .ai-sidebar {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(270px, calc(100% - 36px));
    min-width: min(270px, calc(100% - 36px));
    transform: translateX(-102%);
    box-shadow: var(--shadow-overlay);
    transition: transform var(--speed-slow) var(--ease-standard);
  }

  .ai-app.sidebar-open .ai-sidebar { transform: translateX(0); }
  .ai-app.sidebar-open::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    content: "";
    background: var(--overlay-scrim);
  }

  .ai-mobile-toggle,
  .ai-mobile-close { display: inline-flex; }

  .ai-mobile-toggle {
    position: relative;
    margin-left: -7px;
  }

  .ai-mobile-close {
    position: absolute;
    top: 13px;
    right: 12px;
    z-index: 1;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: 18px;
  }

  .ai-mobile-close:hover { background: var(--surface-hover); }
  .ai-chat-header { min-height: 54px; padding: 0 14px; }
  .ai-header-status { display: none; }
  .ai-messages { gap: 19px; padding: 72px 14px 150px; }
  .ai-msg.user .ai-msg-content { max-width: 84%; }
  .ai-composer-wrap { bottom: 12px; padding: 0 14px; }
  .ai-main:has(.ai-empty) .ai-composer-wrap { top: 50%; bottom: auto; transform: translateY(26px); }
  .ai-composer { min-height: 96px; }
  .ai-composer-hint { display: none; }
  .ai-composer-tool { padding: 0 6px; }
  .ai-composer-tool span { display: none; }
  .ai-model-selector { max-width: 170px; }
  .ai-cowork-popover { width: calc(100vw - 20px); }
  .ai-models-page { padding: 32px 16px 20px; }
  .ai-models-heading p { line-height: 1.4; }
  .ai-models-table-head,
  .ai-model-row { grid-template-columns: minmax(180px, 1fr) 80px; }
  .ai-models-table-head span:nth-child(3),
  .ai-models-table-head span:nth-child(4),
  .ai-models-table-head span:nth-child(5),
  .ai-model-row-capability,
  .ai-model-row-price,
  .ai-model-row-check { display: none; }
  .ai-model-row-context { grid-column: 2; }
}

@media (prefers-reduced-motion: reduce) {
  .ai-app,
  .ai-empty,
  .ai-msg { animation: none; }
  .ai-sidebar,
  .ai-sidebar-item,
  .ai-sidebar-item-del,
  .ai-composer,
  .ai-composer-tool,
  .ai-model-row,
  .ai-usage-track span { transition: none; }
  .ai-cowork-popover { animation: none; }
  .ai-messages { scroll-behavior: auto; }
  .ai-typing span { animation: none; opacity: .65; }
}

html.performance-mode .ai-app,
html.performance-mode .ai-empty,
html.performance-mode .ai-msg { animation: none; }

html.performance-mode .ai-sidebar,
html.performance-mode .ai-sidebar-item,
html.performance-mode .ai-sidebar-item-del,
html.performance-mode .ai-composer,
html.performance-mode .ai-composer-tool,
html.performance-mode .ai-model-row,
html.performance-mode .ai-usage-track span { transition: none; }
html.performance-mode .ai-cowork-popover { animation: none; }
